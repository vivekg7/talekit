{
  "name": "talekit",
  "version": "0.1.0",
  "description": "Good-quality 2D films, reels and animations made by AI agents: they write characters, scenes and shots as JSON; the engine animates, voices and renders them, and answers every write with a picture.",
  "type": "module",
  "license": "MIT",
  "author": "Vivek Kumar Gupta <vivek@ivy.homes>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekg7/talekit.git"
  },
  "homepage": "https://github.com/vivekg7/talekit#readme",
  "bin": {
    "talekit": "dist/cli.js"
  },
  "files": [
    "dist",
    "fonts",
    "sounds",
    "tools/tts/pyproject.toml",
    "tools/tts/uv.lock",
    "tools/tts/speak.py",
    "kit/pyproject.toml",
    "kit/talekit/*.py",
    "kit/templates/*.py",
    "docs/authoring-guide.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "harfbuzzjs": "^1.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
